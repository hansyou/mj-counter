{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mj-counter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ]
}
